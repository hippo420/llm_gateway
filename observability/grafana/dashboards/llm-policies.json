{
  "uid": "llm-policies",
  "title": "LLM Gateway / Policies",
  "tags": [
    "llm-gateway",
    "policy"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pending human approval",
      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_policy_pending",
          "legendFormat": "{{instance}} {{policy_id}} {{decision}} {{deployment_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Under observation",
      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_policy_active",
          "legendFormat": "{{instance}} {{policy_id}} {{decision}} {{deployment_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rollback conflicts",
      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_policy_rollback_conflicts",
          "legendFormat": "{{instance}} {{policy_id}} {{decision}} {{deployment_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Audit store available",
      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
