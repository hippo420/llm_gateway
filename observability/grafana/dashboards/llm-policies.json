      "title": "Completed rollbacks",
      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_policy_rollback_total",
          "legendFormat": "{{instance}} {{policy_id}} {{decision}} {{deployment_id}}"
