      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_deployment_weight",
          "legendFormat": "{{instance}} {{policy_id}} {{decision}} {{deployment_id}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Traffic by deployment",
      "description": "Read-only monitoring. Approval requires authenticated admin API and a reason. Redis audit counters are shared: do not sum replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_id) (rate(llm_gateway_requests_total[$__rate_interval]))",
          "legendFormat": "{{instance}} {{policy_id}} {{decision}} {{deployment_id}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Automatic applications",
      "description": "Phase 10. Admitted tier does not imply activation: global switch, evidence and budgets must also pass. Journal: authenticated /admin/automation-journal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
