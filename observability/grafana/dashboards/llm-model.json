      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model, deployment_id) (rate(llm_gateway_request_duration_seconds_bucket{model=~\"$model\", deployment_id=~\"$deployment\"}[$__rate_interval])))",
          "legendFormat": "{{deployment_id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
