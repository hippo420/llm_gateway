# --- server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- config ---
GATEWAY_CONFIG_PATH=config/gateway.yaml
# 0 disables YAML watching; manual reload remains available.
GATEWAY_CONFIG_RELOAD_SEC=5
# Redis reconciliation and per-deployment expiry checks (independent of YAML watching).
GATEWAY_CONFIG_REDIS_POLL_SEC=5

# --- auth (empty = public chat; all /admin endpoints require a configured key) ---
GATEWAY_API_KEY=

# --- logging ---
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_FORMAT=json
# true 는 로컬 개발에서만. 프롬프트 원문이 로그에 남는다.
GATEWAY_LOG_PROMPT=false

# --- observability (Phase 2) ---
GATEWAY_METRICS_ENABLED=true
GATEWAY_EVALUATION_RESULTS_PATH=operations/evaluations

# --- diagnosis (Phase 3; configure measured baselines before enabling) ---
GATEWAY_DIAGNOSIS_ENABLED=false
GATEWAY_DIAGNOSIS_CONFIG_PATH=config/diagnosis.yaml

# --- dynamic config store (Phase 4) ---
# docker compose --profile config up -d redis
# GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_REDIS_URL=

# --- human-approved policies (Phase 9; requires diagnosis, Redis and admin key) ---
GATEWAY_POLICY_ENABLED=false
GATEWAY_POLICY_CONFIG_PATH=config/policies.yaml
